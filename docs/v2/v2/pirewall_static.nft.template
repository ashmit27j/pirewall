#!/usr/sbin/nft -f
# pirewall v2: static kernel guards (PLAN_v1 section 3.1)
#
# TEMPLATE. It is not applied automatically. Render it and load the rendered
# copy by hand, or through pirewall-start, the same way as base.nft and
# portal.nft.
#
# This table is STATIC POLICY. It is not an adaptive rule.
# - pirewall-core never edits its rules. The kill switch never deletes it;
#   only "panic" does.
# - Its rules match the LAN interface only (iifname). Traffic that arrives on
#   the WAN or admin interface is never touched here.
#
# Writers of its sets. Each set has exactly ONE writer.
#   bound4 / macbind ........ pirewall-leases (read-only watcher of the dnsmasq
#                             lease file, plus config static bindings)
#   allow_bound ............. pirewall-core FirewallManager (A2 allowlist, MAC+IP)
#   *_meter / offenders /
#   unbound_seen ............ the kernel itself (dynamic sets). These are
#                             evidence only: no verdict rule reads them except
#                             the meter rule that creates them.
#
# Enforce / observe switch. A verdict cannot live in a `define` (nft syntax
# error), so every meter hit does `jump guard_verdict_<hook>`.
# - Enforce: that chain contains `drop`.
# - Observe: that chain is empty. The jump returns and the hit is only
#   counted and exported through @offenders.
# pirewall-core switches the mode with a single atomic batch:
#   flush chain inet pirewall_static guard_verdict_forward
#   add rule inet pirewall_static guard_verdict_forward drop
#
# Hook order. A drop in any table is final; an accept only ends that table's
# chain.
#   pirewall_static  prerouting_frag  -450  before nf_defrag (-400)
#   pirewall_static  prerouting_raw   -300  anti-spoof + stateless meters,
#                                           before conntrack
#   pirewall_adaptive prerouting_raw  -299  adaptive block / ratelimit sets
#   pirewall_portal  forward           -10  portal gate (unchanged)
#   pirewall_static  input/forward      -5  stateful guards (DNS, closed
#                                           ports, new-conn rates)
#   pirewall_base    input 0 / forward 10   static posture, policy drop
#                                           (unchanged)
#
# Reload is idempotent: declare everything, then flush CHAINS only. Never use
# `delete table`, because it would wipe bindings and offender state.
#
# Offender codes, as the inet_service half of @offenders:
#   1 syn pps          2 udp pps (to the Pi)     3 icmp pps
#   4 total pps (to the Pi)                      5 closed-port hits on the Pi
#   6 new-conn rate (forward)                    7 new-conn rate per (mac, dst)
#   8 udp pps per (mac, dst) (forward)           10 unbound-source traffic
#   53 dns qps to the Pi                         67 dhcp rate
#   8080 portal concurrency

table inet pirewall_static {
	chain prerouting_frag { type filter hook prerouting priority -450; policy accept; }
	chain prerouting_raw { type filter hook prerouting priority raw; policy accept; }
	chain input_guard { type filter hook input priority -5; policy accept; }
	chain forward_guard { type filter hook forward priority -5; policy accept; }
	chain dhcp_gate { }
	chain unbound { }
	chain flood_meters { }
	chain guard_verdict_raw { }
	chain guard_verdict_input { }
	chain guard_verdict_forward { }
}

flush chain inet pirewall_static prerouting_frag
flush chain inet pirewall_static prerouting_raw
flush chain inet pirewall_static input_guard
flush chain inet pirewall_static forward_guard
flush chain inet pirewall_static dhcp_gate
flush chain inet pirewall_static unbound
flush chain inet pirewall_static flood_meters
flush chain inet pirewall_static guard_verdict_raw
flush chain inet pirewall_static guard_verdict_input
flush chain inet pirewall_static guard_verdict_forward

table inet pirewall_static {
	counter c_ipv6 { comment "IPv6 from LAN (A5: not analysed, dropped)"; }
	counter c_frag { comment "IPv4 fragments from LAN"; }
	counter c_bogon { comment "LAN source outside protected network, or the Pi's own address"; }
	counter c_rpf { comment "reverse-path failure"; }
	counter c_spoof { comment "bound IP used by an unbound MAC"; }
	counter c_bk_syn { comment "global SYN backstop"; }
	counter c_bk_udp { comment "global UDP backstop"; }
	counter c_bk_icmp { comment "global ICMP backstop"; }
	counter c_bk_unbound { comment "global unbound-source backstop"; }
	counter c_bk_newconn { comment "global forward new-conn backstop"; }
	counter c_dns_bypass { comment "LAN to WAN DNS / DoT not via the Pi"; }
	counter c_verdict_raw { }
	counter c_verdict_input { }
	counter c_verdict_forward { }

	# --- written by pirewall-leases ---
	set bound4 { type ipv4_addr; flags timeout; size ${BINDING_SIZE}; }
	set macbind { type ipv4_addr . ether_addr; flags timeout; size ${BINDING_SIZE}; }
	# --- written by pirewall-core FirewallManager (A2 allowlist) ---
	set allow_bound { type ether_addr . ipv4_addr; size ${BINDING_SIZE}; }

	# --- kernel-maintained per-key token buckets. Sized to at least 2x the
	#     DHCP pool; a FULL meter stops policing new keys, so global backstops
	#     follow every class. ---
	set dhcp_meter { type ether_addr; flags dynamic,timeout; timeout 600s; size ${METER_SIZE}; }
	set unbound_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set syn_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set udp_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set icmp_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set pps_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set dns_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set closed_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set portal_conc { type ether_addr; flags dynamic; size ${METER_SIZE}; }
	set newconn_meter { type ether_addr; flags dynamic,timeout; timeout 60s; size ${METER_SIZE}; }
	set newconn_dst_meter { type ether_addr . ipv4_addr; flags dynamic,timeout; timeout 60s; size ${PAIR_METER_SIZE}; }
	set udp_fwd_meter { type ether_addr . ipv4_addr; flags dynamic,timeout; timeout 60s; size ${PAIR_METER_SIZE}; }

	# --- exported evidence. pirewall-core polls these every 1 s
	#     (`nft -j list set`). ---
	set offenders { type ether_addr . inet_service; flags dynamic,timeout; timeout 120s; size ${OFFENDER_SIZE}; }
	set unbound_seen { type ether_addr . ipv4_addr; flags dynamic,timeout; timeout 600s; size ${OFFENDER_SIZE}; }

	# Fragments must be matched BEFORE nf_defrag_ipv4 (priority -400). At
	# priority raw (-300) the kernel has already reassembled them, and
	# frag-off is always 0 there.
	chain prerouting_frag {
		type filter hook prerouting priority -450; policy accept;
		iifname != "${LAN_INTERFACE}" return
		ip frag-off & 0x3fff != 0 counter name c_frag drop
	}

	chain prerouting_raw {
		type filter hook prerouting priority raw; policy accept;
		iifname != "${LAN_INTERFACE}" return
		meta nfproto ipv6 counter name c_ipv6 drop
		meta nfproto != ipv4 return
		# DHCP from not-yet-configured clients: rate-braked per MAC, then
		# allowed through.
		udp sport 68 udp dport 67 jump dhcp_gate
		# Link-local multicast / broadcast (mDNS, SSDP, IGMP) are exempt from
		# anti-spoof.
		ip daddr { 224.0.0.0/4, 255.255.255.255, ${LAN_BROADCAST} } return
		# Source validation, in order: subnet, the Pi itself, reverse path,
		# then IP<->MAC.
		ip saddr != ${PROTECTED_NETWORK} counter name c_bogon drop
		ip saddr ${PIREWALL_LAN_IP} counter name c_bogon drop
		fib saddr . iif oif missing counter name c_rpf drop
		ip saddr @bound4 ip saddr . ether saddr != @macbind counter name c_spoof drop
		ip saddr != @bound4 jump unbound
		# A2 allowlist, keyed on MAC+IP and checked only AFTER anti-spoof.
		# An allowlisted device has no flood protection, by design.
		ether saddr . ip saddr @allow_bound return
		jump flood_meters
	}

	chain dhcp_gate {
		add @dhcp_meter { ether saddr limit rate over ${DHCP_PER_MINUTE}/minute burst ${DHCP_BURST} packets } update @offenders { ether saddr . 67 } jump guard_verdict_raw
		ip saddr 0.0.0.0 accept
	}

	# Sources in the protected network that hold no DHCP binding: static-IP
	# devices, lease lag, or forgery. Recorded, tightly metered, and backed by
	# a keyless global backstop.
	chain unbound {
		update @unbound_seen { ether saddr . ip saddr }
		add @unbound_meter { ether saddr limit rate over ${UNBOUND_PPS}/second burst ${UNBOUND_BURST} packets } update @offenders { ether saddr . 10 } jump guard_verdict_raw
		limit rate over ${GLOBAL_UNBOUND_PPS}/second burst ${GLOBAL_UNBOUND_BURST} packets counter name c_bk_unbound jump guard_verdict_raw
	}

	# Stateless per-MAC meters, before conntrack, so floods cannot fill the
	# conntrack table. SYN and ICMP apply to all traffic. UDP and total-pps
	# apply only to traffic addressed to the Pi itself (fib daddr type
	# local). Forwarded UDP (QUIC, video, games) is metered per (mac, dst)
	# in forward_guard instead. These catch floods against services that DO
	# reply, which `ct state new` meters miss.
	chain flood_meters {
		tcp flags & (fin | syn | rst | ack) == syn add @syn_meter { ether saddr limit rate over ${SYN_PPS}/second burst ${SYN_BURST} packets } update @offenders { ether saddr . 1 } jump guard_verdict_raw
		meta l4proto icmp add @icmp_meter { ether saddr limit rate over ${ICMP_PPS}/second burst ${ICMP_BURST} packets } update @offenders { ether saddr . 3 } jump guard_verdict_raw
		fib daddr type local meta l4proto udp add @udp_meter { ether saddr limit rate over ${UDP_LOCAL_PPS}/second burst ${UDP_LOCAL_BURST} packets } update @offenders { ether saddr . 2 } jump guard_verdict_raw
		fib daddr type local add @pps_meter { ether saddr limit rate over ${LOCAL_PPS}/second burst ${LOCAL_BURST} packets } update @offenders { ether saddr . 4 } jump guard_verdict_raw
		# Keyless backstops. They engage if a meter set is full or many MACs
		# flood together.
		tcp flags & (fin | syn | rst | ack) == syn limit rate over ${GLOBAL_SYN_PPS}/second burst ${GLOBAL_SYN_BURST} packets counter name c_bk_syn jump guard_verdict_raw
		meta l4proto icmp limit rate over ${GLOBAL_ICMP_PPS}/second burst ${GLOBAL_ICMP_BURST} packets counter name c_bk_icmp jump guard_verdict_raw
		fib daddr type local meta l4proto udp limit rate over ${GLOBAL_UDP_LOCAL_PPS}/second burst ${GLOBAL_UDP_LOCAL_BURST} packets counter name c_bk_udp jump guard_verdict_raw
	}

	chain input_guard {
		type filter hook input priority -5; policy accept;
		iifname != "${LAN_INTERFACE}" return
		ether saddr . ip saddr @allow_bound return
		udp dport 53 add @dns_meter { ether saddr limit rate over ${DNS_QPS}/second burst ${DNS_BURST} packets } update @offenders { ether saddr . 53 } jump guard_verdict_input
		# New connections to ports the Pi does not offer to the LAN: scan
		# evidence. pirewall_base drops these anyway, so enforce mode only
		# adds the evidence.
		ct state new tcp dport != { 53, 80, ${PORTAL_PORT} } add @closed_meter { ether saddr limit rate over ${CLOSED_PPS}/second burst ${CLOSED_BURST} packets } update @offenders { ether saddr . 5 } jump guard_verdict_input
		ct state new udp dport != { 53, 67 } add @closed_meter { ether saddr limit rate over ${CLOSED_PPS}/second burst ${CLOSED_BURST} packets } update @offenders { ether saddr . 5 } jump guard_verdict_input
		ct state new tcp dport { 80, ${PORTAL_PORT} } add @portal_conc { ether saddr ct count over ${PORTAL_CONCURRENCY} } update @offenders { ether saddr . 8080 } jump guard_verdict_input
	}

	chain forward_guard {
		type filter hook forward priority -5; policy accept;
		iifname != "${LAN_INTERFACE}" return
		# Force DNS through the Pi. This is static policy, not metered.
		meta l4proto { tcp, udp } th dport { 53, 853 } counter name c_dns_bypass drop
		ether saddr . ip saddr @allow_bound return
		ct state new add @newconn_meter { ether saddr limit rate over ${NEWCONN_PPS}/second burst ${NEWCONN_BURST} packets } update @offenders { ether saddr . 6 } jump guard_verdict_forward
		ct state new add @newconn_dst_meter { ether saddr . ip daddr limit rate over ${NEWCONN_DST_PPS}/second burst ${NEWCONN_DST_BURST} packets } update @offenders { ether saddr . 7 } jump guard_verdict_forward
		meta l4proto udp add @udp_fwd_meter { ether saddr . ip daddr limit rate over ${UDP_FWD_PPS}/second burst ${UDP_FWD_BURST} packets } update @offenders { ether saddr . 8 } jump guard_verdict_forward
		ct state new limit rate over ${GLOBAL_NEWCONN_PPS}/second burst ${GLOBAL_NEWCONN_BURST} packets counter name c_bk_newconn jump guard_verdict_forward
	}

	# Verdict chains. `${RAW_VERDICT}` / `${INPUT_VERDICT}` / `${FORWARD_VERDICT}`
	# render to `drop` (enforce) or to nothing (observe).
	# Defaults (PLAN_v1 3.1):
	#   raw = enforce, but only once bindings are seeded, otherwise observe
	#   input = enforce
	#   forward = observe, until the benign false-positive check passes
	chain guard_verdict_raw {
		counter name c_verdict_raw ${RAW_VERDICT}
	}
	chain guard_verdict_input {
		counter name c_verdict_input ${INPUT_VERDICT}
	}
	chain guard_verdict_forward {
		counter name c_verdict_forward ${FORWARD_VERDICT}
	}
}

# ARP anti-impersonation. An `inet` table never sees ARP, so without this a
# LAN client could poison the Pi's neighbour cache for a bound IP and receive
# that client's return traffic. The sets mirror bound4 / macbind and are
# written by pirewall-leases in the same batch.
table arp pirewall_static_arp {
	chain input { type filter hook input priority 0; policy accept; }
}
flush chain arp pirewall_static_arp input
table arp pirewall_static_arp {
	counter c_arp_spoof { }
	set bound4 { type ipv4_addr; flags timeout; size ${BINDING_SIZE}; }
	set macbind { type ipv4_addr . ether_addr; flags timeout; size ${BINDING_SIZE}; }
	chain input {
		type filter hook input priority 0; policy accept;
		meta iifname != "${LAN_INTERFACE}" return
		arp saddr ip ${PIREWALL_LAN_IP} counter name c_arp_spoof drop
		arp saddr ip @bound4 arp saddr ip . arp saddr ether != @macbind counter name c_arp_spoof drop
	}
}
