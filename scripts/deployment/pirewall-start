#!/usr/bin/env bash
# pirewall-start — bring the whole pirewall stack up on the Pi, in order (v2).
#
# Encodes docs/SETUP.md as one idempotent, re-runnable script, extended for v2
# (docs/ADDENDUM_4.md, docs/v2/PLAN_v3.md §6). Safe to run repeatedly: every
# step checks whether it has already been done and says so rather than
# redoing it. The config-dependent steps live in scripts/deployment/startup.py
# (`startup.py --help`); this script owns the order.
#
# ORDER (live / scripted, as root):
#   preflight -> snapshot -> accounts -> directories -> render ->
#   base -> static -> adaptive -> seed bindings + allow_bound ->
#   guard verdicts -> core -> api -> portal -> portal.nft -> manifest
#
# WHAT IT DOES NOT DO, on purpose:
#
#   * It never generates configuration or TLS material for a real run.
#     `configure.py` asks for the Admin PC, its MAC and the password, and
#     deliberately refuses to guess them. (Mock mode makes a throwaway
#     loopback certificate inside its own run directory, nothing more.)
#   * It never loads deploy/rendered/nat-masquerade.nft when NetworkManager's
#     `shared` mode is already masquerading the LAN.
#   * It never deletes a v2 table, except under --panic. Reloads declare
#     everything and flush chains, so bindings and offender state survive.
#
# ORDERING IS THE POINT:
#
#   1. The raw guard loads in observe and is raised to enforce only once the
#      bindings are seeded (ADDENDUM_4.md D2). Enforcing anti-spoof with an
#      empty binding set would meter every client as unbound.
#   2. The captive-portal nft table is loaded only after pirewall-portal is
#      confirmed serving: it rejects forwarding for unauthenticated clients.
#   3. pirewall-core starts before pirewall-portal: core creates its socket.
#
# Usage:
#   sudo scripts/deployment/pirewall-start                    # bring everything up
#   sudo scripts/deployment/pirewall-start --check            # preflight only, change nothing
#   scripts/deployment/pirewall-start --dry-run               # print every command, run none
#   sudo scripts/deployment/pirewall-start --no-portal        # core + api only
#   sudo scripts/deployment/pirewall-start --skip-nft         # leave the ruleset alone
#   sudo scripts/deployment/pirewall-start --engine v1        # pipeline: v1 baseline, or v2 (policy engine)
#   sudo scripts/deployment/pirewall-start --guards observe   # all three guards; or per guard:
#        --guard-raw MODE --guard-input MODE --guard-forward MODE    (MODE: observe|enforce)
#   sudo scripts/deployment/pirewall-start --data-mode live   # claim env pi-live (Pi only)
#   sudo scripts/deployment/pirewall-start --data-mode scripted   # claim env pi-scripted (Pi only)
#   scripts/deployment/pirewall-start --data-mode mock [--pcap PATH] [--run-dir DIR]
#        # no root, no nft: core replays pcaps against in-memory firewall fakes,
#        # the API serves https://127.0.0.1 (env tag mock). Ctrl-C stops both.
#   sudo scripts/deployment/pirewall-start --panic            # delete the v2 tables, print the restore
#   sudo scripts/deployment/pirewall-start --lab-victim up|down   # the forward-path victim netns
#   ... --manifest PATH                                       # also copy the run manifest here
#   ... --config PATH                                         # default config/local_config.toml
#
# Without --data-mode the env tag comes from the config (default sandbox), so a
# Pi result is only ever claimed explicitly (ADDENDUM_4.md D7).
#
# Exit codes: 0 all good, 1 a step failed, 2 preflight refused to start.

set -euo pipefail

readonly REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly VENV_PY="${PIREWALL_PYTHON:-${REPO_ROOT}/.venv/bin/python}"
readonly TMPFILES_SRC="${REPO_ROOT}/deploy/systemd/pirewall-tmpfiles.conf"
readonly ROLLBACK_DIR="${REPO_ROOT}/deploy/rollback"
readonly RENDERED="${REPO_ROOT}/deploy/rendered"
readonly UNIT_DIR="/etc/systemd/system"
readonly DNSMASQ_DROPIN="/etc/NetworkManager/dnsmasq-shared.d/pirewall-portal.conf"
readonly STATE_MANIFEST="/var/lib/pirewall/manifest.json"
readonly LAB_RUN_DIR="/run/pirewall-lab"

# How long to wait for a service to actually become useful (socket bound,
# port listening) rather than merely "active". systemd reports a Type=simple
# unit active the moment it forks, which tells us nothing.
readonly READY_TIMEOUT_SECONDS=30

DRY_RUN=0
CHECK_ONLY=0
WANT_PORTAL=1
SKIP_NFT=0
ENGINE=""
GUARDS=""
GUARD_RAW=""
GUARD_INPUT=""
GUARD_FORWARD=""
DATA_MODE=""
PANIC=0
LAB_VICTIM=""
MANIFEST_COPY=""
PCAP=""
RUN_DIR=""
CONFIG_FILE="${REPO_ROOT}/config/local_config.toml"
SEEDED=""

EXIT_OK=0
EXIT_FAILED=1
EXIT_REFUSED=2

# ----------------------------------------------------------------- output

if [[ -t 1 ]]; then
  readonly C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_DIM=$'\033[2m'
  readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_BLUE=$'\033[34m'
else
  readonly C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_BLUE=''
fi

step()  { printf '\n%s==>%s %s%s%s\n' "$C_BLUE" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"; }
ok()    { printf '    %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
skip()  { printf '    %s·%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
warn()  { printf '    %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
fail()  { printf '\n%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

die() { fail "$*"; exit "$EXIT_FAILED"; }

refuse() {
  fail "$1"
  shift
  [[ $# -gt 0 ]] && printf '\n%s\n' "$*" >&2
  exit "$EXIT_REFUSED"
}

# Run a command, or print it under --dry-run. Every mutating action in this
# script goes through this, so --dry-run is genuinely complete rather than
# best-effort.
run() {
  if (( DRY_RUN )); then
    printf '    %s$ %s%s\n' "$C_DIM" "$*" "$C_RESET"
    return 0
  fi
  "$@"
}

# The Python helper (scripts/deployment/startup.py), with the config this run
# uses. HELPER is the same command as an array, for `run` to print verbatim.
helper() { "$VENV_PY" -m scripts.deployment.startup --config "$CONFIG_FILE" "$@"; }

# Guard flags for the helper: config modes, then --guards, then per guard.
guard_args() {
  local -a args=()
  [[ -n "$GUARDS" ]] && args+=(--guards "$GUARDS")
  [[ -n "$GUARD_RAW" ]] && args+=(--guard-raw "$GUARD_RAW")
  [[ -n "$GUARD_INPUT" ]] && args+=(--guard-input "$GUARD_INPUT")
  [[ -n "$GUARD_FORWARD" ]] && args+=(--guard-forward "$GUARD_FORWARD")
  # Nothing at all when no flag was given: an empty line would become an
  # empty argument, which argparse rejects.
  [[ ${#args[@]} -eq 0 ]] || printf '%s\n' "${args[@]}"
}

# ------------------------------------------------------------- arguments

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; $d'; }

need_value() {
  [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || { fail "$1 needs a value"; echo; usage >&2; exit "$EXIT_REFUSED"; }
}

need_mode() {
  case "$2" in observe|enforce) ;; *) fail "$1 takes observe or enforce, not '$2'"; exit "$EXIT_REFUSED" ;; esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)       DRY_RUN=1 ;;
    --check)         CHECK_ONLY=1 ;;
    --no-portal)     WANT_PORTAL=0 ;;
    --skip-nft)      SKIP_NFT=1 ;;
    --panic)         PANIC=1 ;;
    --engine)        need_value "$@"; ENGINE="$2"; shift
                     case "$ENGINE" in v1|v2) ;; *) refuse "--engine takes v1 or v2, not '$ENGINE'" ;; esac ;;
    --guards)        need_value "$@"; need_mode "$1" "$2"; GUARDS="$2"; shift ;;
    --guard-raw)     need_value "$@"; need_mode "$1" "$2"; GUARD_RAW="$2"; shift ;;
    --guard-input)   need_value "$@"; need_mode "$1" "$2"; GUARD_INPUT="$2"; shift ;;
    --guard-forward) need_value "$@"; need_mode "$1" "$2"; GUARD_FORWARD="$2"; shift ;;
    --data-mode)     need_value "$@"; DATA_MODE="$2"; shift
                     case "$DATA_MODE" in live|scripted|mock) ;; *) refuse "--data-mode takes live, scripted or mock" ;; esac ;;
    --lab-victim)    need_value "$@"; LAB_VICTIM="$2"; shift
                     case "$LAB_VICTIM" in up|down) ;; *) refuse "--lab-victim takes up or down" ;; esac ;;
    --manifest)      need_value "$@"; MANIFEST_COPY="$2"; shift ;;
    --pcap)          need_value "$@"; PCAP="$2"; shift ;;
    --run-dir)       need_value "$@"; RUN_DIR="$2"; shift ;;
    --config)        need_value "$@"; CONFIG_FILE="$2"; shift ;;
    -h|--help)       usage; exit "$EXIT_OK" ;;
    *)               fail "unknown option: $1"; echo; usage >&2; exit "$EXIT_REFUSED" ;;
  esac
  shift
done

if (( PANIC )) && [[ -n "$LAB_VICTIM" || -n "$DATA_MODE" ]]; then
  refuse "--panic cannot be combined with --lab-victim or --data-mode"
fi
if [[ -n "$PCAP$RUN_DIR" && "$DATA_MODE" != "mock" ]]; then
  refuse "--pcap and --run-dir only apply to --data-mode mock"
fi
readonly HELPER=("$VENV_PY" -m scripts.deployment.startup --config "$CONFIG_FILE")

# ------------------------------------------------------------- preflight

need_root() {
  if (( DRY_RUN || CHECK_ONLY )); then return 0; fi
  [[ $EUID -eq 0 ]] || refuse "this script must run as root (it loads nftables rules and manages services)" \
    "Try: sudo ${BASH_SOURCE[0]} $*"
}

require_binary() {
  command -v "$1" >/dev/null 2>&1 || refuse "required command not found: $1" "$2"
}

require_venv() {
  [[ -x "$VENV_PY" ]] || refuse "no virtualenv at ${VENV_PY}" \
    "Create it first:  cd ${REPO_ROOT} && uv sync"
  ok "virtualenv: $("$VENV_PY" --version)"
}

# Load the config through the real Pydantic models, so anything this script
# reads has already been validated the same way the daemons validate it.
# Values are shell-quoted by python, never interpolated raw.
load_config_env() {
  [[ -f "$CONFIG_FILE" ]] || refuse "no config at ${CONFIG_FILE}" \
    "Generate it first — it asks for the Admin PC, its MAC and the admin password,
and deliberately refuses to guess any of them:

    cd ${REPO_ROOT} && uv run python -m scripts.deployment.configure"
  ok "config: ${CONFIG_FILE}"

  local config_env
  if ! config_env="$(PIREWALL_CONFIG_FILE="$CONFIG_FILE" "$VENV_PY" - <<'PY'
import os
import shlex
import sys
from pathlib import Path

from pirewall.config.loader import load_config

try:
    c = load_config(os.environ["PIREWALL_CONFIG_FILE"])
except Exception as exc:  # any validation failure, reported not raised
    print(f"CONFIG_ERROR={shlex.quote(str(exc))}")
    sys.exit(0)

cert = Path(c.api.tls_cert_path)
pairs = {
    "WAN_IF": c.network.wan_interface,
    "LAN_IF": c.network.lan_interface,
    "LAN_IP": str(c.network.pirewall_lan_ip),
    "PROTECTED": str(c.network.protected_network),
    "GATEWAY": str(c.network.upstream_gateway),
    "ADMIN_PC": str(c.admin.admin_pc_ip),
    "API_PORT": str(c.api.port),
    "CORE_SOCK": c.api.rpc_socket_path,
    "TLS_CERT": str(cert),
    "PORTAL_ENABLED": "1" if c.portal.enabled else "0",
    "PORTAL_HOST": str(c.portal.listen_host),
    "PORTAL_PORT": str(c.portal.listen_port),
    "PORTAL_SOCK": c.portal.rpc_socket_path,
    "PORTAL_GROUP": c.portal.rpc_socket_group,
    "USER_STORE": c.portal.user_store_path,
    "ENFORCEMENT": c.firewall.enforcement_mode.value,
    "CONFIG_ENGINE": c.pipeline.engine.value,
    "CONFIG_ENV": c.lab.env_tag.value,
}
for key, value in pairs.items():
    print(f"{key}={shlex.quote(value)}")
PY
  )"; then
    refuse "could not load ${CONFIG_FILE}" "Run: uv run python -m pirewall.main --config ${CONFIG_FILE} --check-config"
  fi
  eval "$config_env"

  if [[ -n "${CONFIG_ERROR:-}" ]]; then
    refuse "${CONFIG_FILE} is invalid: ${CONFIG_ERROR}" \
      "Run: uv run python -m pirewall.main --config ${CONFIG_FILE} --check-config"
  fi
  ok "config valid — enforcement=${ENFORCEMENT}, engine=${ENGINE:-$CONFIG_ENGINE}, LAN ${PROTECTED} on ${LAN_IF}, WAN ${WAN_IF}"
}

preflight() {
  step "Preflight"

  cd "$REPO_ROOT"
  ok "repository root: $REPO_ROOT"
  require_venv

  require_binary nft        "Install it:  sudo apt install nftables"
  require_binary systemctl  "This script targets a systemd host."
  require_binary systemd-tmpfiles "This script targets a systemd host."
  ok "nft, systemctl, systemd-tmpfiles present"

  if grep -q 'CHANGE_ME' "$CONFIG_FILE" 2>/dev/null; then
    refuse "${CONFIG_FILE} still contains CHANGE_ME placeholders" \
      "Fix them, or re-run:  uv run python -m scripts.deployment.configure"
  fi
  load_config_env

  # Interfaces have to exist before rules referencing them are loaded, or nft
  # accepts the ruleset and it silently matches nothing.
  local missing=()
  for iface in "$WAN_IF" "$LAN_IF"; do
    ip link show "$iface" >/dev/null 2>&1 || missing+=("$iface")
  done
  if (( ${#missing[@]} )); then
    refuse "configured interface(s) not present: ${missing[*]}" \
      "Bring them up first (docs/SETUP.md §0), or re-run:
    uv run python -m scripts.deployment.configure --detect"
  fi
  ok "interfaces present: ${WAN_IF} (WAN), ${LAN_IF} (LAN)"

  # The configured gateway is the address §24 safety validation protects from
  # ever being blocked. A stale value means the real gateway is unprotected,
  # which is silent and dangerous.
  local live_gateway
  live_gateway="$(ip -4 route show default | awk '{print $3; exit}')"
  if [[ -n "$live_gateway" && "$live_gateway" != "$GATEWAY" ]]; then
    warn "network.upstream_gateway is ${GATEWAY} but the live default route is ${live_gateway}"
    warn "  that address is what safety validation protects — fix it before going live:"
    warn "  uv run python -m scripts.deployment.configure --detect"
  else
    ok "upstream gateway matches the live default route: ${GATEWAY}"
  fi

  local cert="$TLS_CERT"
  [[ "$cert" == /* ]] || cert="${REPO_ROOT}/${cert}"
  if [[ -f "$cert" ]]; then
    ok "TLS certificate present"
  else
    refuse "no TLS certificate at ${TLS_CERT}" \
      "Generate it first:  scripts/deployment/make_certs.sh ${LAN_IP}"
  fi

  if (( WANT_PORTAL )) && [[ "$PORTAL_ENABLED" != "1" ]]; then
    warn "portal.enabled is false in the config — skipping every portal step"
    warn "  set it to true in the config to enable the captive portal"
    WANT_PORTAL=0
  fi

  check_lease_file
  v2_preflight
}

# The v2 refusals (ADDENDUM_4.md, PLAN_v3 §6): nftables.service flush hazard,
# IPv6 on the LAN, an unmigrated config, a missing admin MAC/interface, model
# artifacts that do not match their sidecars, an engine not yet implemented,
# a pi-* claim off a Pi. Reports: nft transport, native ring, chrony.
v2_preflight() {
  step "v2 preflight"
  local -a args=(preflight)
  [[ -n "$ENGINE" ]] && args+=(--engine "$ENGINE")
  [[ -n "$DATA_MODE" ]] && args+=(--data-mode "$DATA_MODE")
  local status=0
  helper "${args[@]}" || status=$?
  case "$status" in
    0) ;;
    2) refuse "v2 preflight refused to start (see above for what to fix)" ;;
    *) die "the v2 preflight could not run (exit ${status})" ;;
  esac
}

# Portal sign-in is refused for a client with no IP<->MAC binding, and the
# bindings come from antispoof.lease_file. A wrong or stale path fails
# silently: the file never changes and nobody can sign in. So with the
# portal on, anything but a file a running dnsmasq is writing, and that
# pirewall-core can read, is a refusal. With the portal off it only costs
# anti-spoof bindings, so it is a warning (and the raw guard stays observe).
check_lease_file() {
  local lease_env
  if ! lease_env="$("$VENV_PY" -m scripts.deployment.lease_check --config "$CONFIG_FILE" --shell)"; then
    refuse "the lease-file check could not run" "Run: uv run python -m scripts.deployment.lease_check"
  fi
  eval "$lease_env"

  local fix="antispoof.lease_file is derived from network.lan_interface (${LAN_IF}) when unset.
Check that the NetworkManager shared connection on ${LAN_IF} is up, and remove
any explicit antispoof.lease_file from the config unless your DHCP server
really writes somewhere else. Diagnose with:
    uv run python -m scripts.deployment.lease_check"

  case "$LEASE_STATE" in
    ok)
      ok "$LEASE_MESSAGE"
      ;;
    unreadable)
      if (( EUID != 0 )); then
        warn "$LEASE_MESSAGE"
        warn "  not running as root, so whether pirewall-core can read it is undecided"
        return 0
      fi
      lease_problem "$LEASE_MESSAGE" "$fix"
      return 0
      ;;
    *)
      lease_problem "$LEASE_MESSAGE" "$fix"
      return 0
      ;;
  esac

  # Readable by root is not readable by the account that actually reads it.
  if (( EUID == 0 )) && id -u pirewall-core >/dev/null 2>&1; then
    if runuser -u pirewall-core -- test -r "$LEASE_FILE"; then
      ok "pirewall-core can read the lease file"
    else
      lease_problem "pirewall-core cannot read ${LEASE_FILE}" \
        "Check the permissions on ${LEASE_FILE} and its directory."
    fi
  fi
}

lease_problem() {
  if (( WANT_PORTAL )); then
    refuse "$1 — portal sign-in needs IP<->MAC bindings from this file" "$2"
  fi
  warn "$1"
  warn "  anti-spoof bindings will come from [[antispoof.static]] only"
}

# --------------------------------------------------------------- helpers

# systemd calls a Type=simple unit "active" the instant it forks, which is
# not the same as ready. Wait for the thing that actually matters instead.
wait_for() {
  local what="$1" test_cmd="$2" waited=0
  if (( DRY_RUN )); then skip "would wait for ${what}"; return 0; fi
  while (( waited < READY_TIMEOUT_SECONDS )); do
    if eval "$test_cmd" >/dev/null 2>&1; then
      ok "${what} ready (${waited}s)"
      return 0
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done
  return 1
}

start_unit() {
  local unit="$1" what="$2" ready_test="$3"
  # The crash-loop limiter is armed (ADDENDUM_3.md), so a unit that failed
  # earlier refuses to start again until its counter is cleared. Clearing it
  # here is what makes this script re-runnable after a failed attempt.
  run systemctl reset-failed "$unit" 2>/dev/null || true
  run systemctl restart "$unit"
  if ! wait_for "$what" "$ready_test"; then
    fail "${unit} did not become ready within ${READY_TIMEOUT_SECONDS}s"
    printf '\n%s\n' "Last 20 log lines:" >&2
    journalctl -u "$unit" -n 20 --no-pager >&2 || true
    exit "$EXIT_FAILED"
  fi
}

# Load one rendered ruleset: syntax-checked first, always. A bad ruleset
# applied to a live box is how you lose the network you are connected over.
load_ruleset() {
  local file="$1" label="$2"
  [[ -f "$file" ]] || (( DRY_RUN )) || die "missing ${file} — did rendering fail?"
  run nft -c -f "$file" || die "${label} failed its syntax check — nothing was loaded"
  run nft -f "$file"
  ok "loaded ${label}"
}

# ----------------------------------------------------------------- steps

snapshot_ruleset() {
  step "Snapshot the current nftables ruleset"
  local stamp file
  stamp="$(date +%Y%m%d-%H%M%S)"
  file="${ROLLBACK_DIR}/ruleset-${stamp}.nft"

  if (( DRY_RUN )); then skip "would write ${file}"; return 0; fi

  mkdir -p "$ROLLBACK_DIR"
  {
    echo "#!/usr/sbin/nft -f"
    echo "# pirewall rollback snapshot taken $(date -Is) by pirewall-start"
    echo "# Restore with:"
    echo "#   sudo nft flush ruleset && sudo nft -f ${file}"
    echo "#   sudo systemctl restart NetworkManager"
    echo "#"
    ip -br addr | sed 's/^/#   /'
    echo "#"
    nft list ruleset
  } > "$file"
  echo "$stamp" > "${ROLLBACK_DIR}/.latest"
  ok "saved ${file#"$REPO_ROOT"/}"
}

ensure_accounts() {
  step "Service accounts and groups"

  local -a groups=(pirewall-ipc pirewall-core pirewall-api)
  (( WANT_PORTAL )) && groups+=(pirewall-portal-ipc pirewall-portal)

  for group in "${groups[@]}"; do
    if getent group "$group" >/dev/null; then
      skip "group ${group} exists"
    else
      run groupadd --system "$group"
      ok "created group ${group}"
    fi
  done

  _ensure_user pirewall-core pirewall-core pirewall-ipc
  _ensure_user pirewall-api  pirewall-api  pirewall-ipc
  if (( WANT_PORTAL )); then
    _ensure_user pirewall-portal pirewall-portal pirewall-portal-ipc
    # pirewall-core serves BOTH RPC sockets, so it needs to be in the
    # portal's group as well as its own.
    if id -nG pirewall-core 2>/dev/null | tr ' ' '\n' | grep -qx pirewall-portal-ipc; then
      skip "pirewall-core already in pirewall-portal-ipc"
    else
      run usermod -a -G pirewall-portal-ipc pirewall-core
      ok "added pirewall-core to pirewall-portal-ipc"
    fi
  fi

  # The privilege boundary, asserted rather than assumed (ADDENDUM_3.md C1).
  if (( WANT_PORTAL && ! DRY_RUN )); then
    if id -nG pirewall-portal | tr ' ' '\n' | grep -qx pirewall-ipc; then
      die "pirewall-portal is in pirewall-ipc — that group reaches the privileged
       RPC socket carrying the kill switch and every rule mutation. Remove it:
           sudo gpasswd -d pirewall-portal pirewall-ipc"
    fi
    ok "pirewall-portal is NOT in pirewall-ipc (privilege boundary intact)"
  fi
}

_ensure_user() {
  local user="$1" primary="$2" supplementary="$3"
  if id -u "$user" >/dev/null 2>&1; then
    skip "user ${user} exists"
    return 0
  fi
  run useradd --system --no-create-home --shell /usr/sbin/nologin \
      -g "$primary" -G "$supplementary" "$user"
  ok "created user ${user}"
}

ensure_directories() {
  step "Runtime, state and log directories"
  [[ -f "$TMPFILES_SRC" ]] || die "missing ${TMPFILES_SRC}"
  run install -m 0644 "$TMPFILES_SRC" /etc/tmpfiles.d/pirewall.conf
  run systemd-tmpfiles --create /etc/tmpfiles.d/pirewall.conf
  ok "applied /etc/tmpfiles.d/pirewall.conf"

  if (( WANT_PORTAL && ! DRY_RUN )); then
    # The setgid bit is what gives the portal socket its group without
    # pirewall-core calling chown, which its own SystemCallFilter forbids.
    local dir; dir="$(dirname "$PORTAL_SOCK")"
    local mode; mode="$(stat -c '%a' "$dir" 2>/dev/null || echo missing)"
    local group; group="$(stat -c '%G' "$dir" 2>/dev/null || echo missing)"
    if [[ "$mode" == "2750" && "$group" == "$PORTAL_GROUP" ]]; then
      ok "${dir} is setgid ${PORTAL_GROUP}"
    else
      die "${dir} is mode ${mode} group ${group}, expected 2750 ${PORTAL_GROUP}.
       Without the setgid bit the portal socket lands in the wrong group and
       pirewall-portal can never reach it. Check ${TMPFILES_SRC}."
    fi
  fi

  # ML artifacts must be readable by the core user.
  local artifacts="${REPO_ROOT}/pirewall/ml/artifacts"
  if compgen -G "${artifacts}/*.txt" >/dev/null || compgen -G "${artifacts}/*.joblib" >/dev/null; then
    run chown pirewall-core:pirewall-ipc "${artifacts}"/*.txt "${artifacts}"/*.joblib \
        "${artifacts}"/*.json 2>/dev/null || true
    ok "ML artifacts owned by pirewall-core"
  else
    warn "no ML model artifacts found — pirewall runs behaviour-only detection"
  fi
}

render_templates() {
  step "Render deployment templates"
  # The raw guard renders as observe whatever was asked: it is raised to
  # enforce by set_guard_verdicts, and only once the bindings are seeded.
  local -a modes; mapfile -t modes < <(guard_args)
  run "${HELPER[@]}" render "${modes[@]}"
  ok "rendered into deploy/rendered/ (raw guard loads in observe until seeded)"
}

load_base_ruleset() {
  step "Load the base nftables ruleset"
  if (( SKIP_NFT )); then skip "--skip-nft given"; return 0; fi

  local base="${RENDERED}/base.nft"
  [[ -f "$base" ]] || (( DRY_RUN )) || die "missing ${base} — did rendering fail?"

  # Check before load, always. A syntactically bad ruleset applied to a live
  # box is how you lose a network you are connected over.
  run nft -c -f "$base" || die "base.nft failed its syntax check — nothing was loaded"
  ok "base.nft passes nft -c"

  run nft -f "$base"
  ok "loaded table inet pirewall_base"

  # NetworkManager's shared mode already masquerades the LAN. Loading ours on
  # top leaves two masquerade rules where one is wanted.
  local nat="${RENDERED}/nat-masquerade.nft"
  case "$(nm_shared_nat_state)" in
    present)
      skip "NetworkManager already masquerades ${PROTECTED} (nm-shared-${LAN_IF}) — not loading nat-masquerade.nft"
      ;;
    absent)
      if [[ -f "$nat" ]]; then
        run nft -c -f "$nat" || die "nat-masquerade.nft failed its syntax check"
        run nft -f "$nat"
        ok "loaded table ip pirewall_nat"
      fi
      ;;
    unknown)
      # Only reachable under --dry-run, which does not run as root. Saying
      # "would load it" here would be a guess presented as a plan, and the
      # wrong guess adds a duplicate masquerade rule.
      warn "cannot read the ruleset without root — whether NetworkManager already"
      warn "  masquerades ${PROTECTED} is undecided, so nat-masquerade.nft may or may"
      warn "  not be loaded on a real run. Check with: sudo nft list tables"
      ;;
  esac
}

# present | absent | unknown. Distinguishing "no such table" from "could not
# look" matters: treating an unreadable ruleset as "absent" is how you end up
# loading a second masquerade rule on top of NetworkManager's.
nm_shared_nat_state() {
  local output
  if ! output="$(nft list tables 2>/dev/null)"; then
    echo unknown
    return 0
  fi
  if grep -q "nm-shared-${LAN_IF}" <<<"$output"; then
    echo present
  else
    echo absent
  fi
}

# ADDENDUM_4.md D1: the two v2 tables (plus the ARP companion, in the static
# file). Each file declares everything and then flushes chains; it never
# deletes a table, so live bindings and offender state survive a reload.
load_v2_tables() {
  step "Load the v2 kernel tables (static guards, adaptive sets)"
  if (( SKIP_NFT )); then skip "--skip-nft given"; return 0; fi
  retire_v1_adaptive_table
  load_ruleset "${RENDERED}/pirewall_static.nft" "table inet pirewall_static + arp pirewall_static_arp"
  load_ruleset "${RENDERED}/pirewall_adaptive.nft" "table inet pirewall_adaptive"
}

# v1 enforced adaptive rules in `table inet pirewall` (forward hook). v2
# never writes it, so whatever a v1 run left there would keep dropping with
# nothing left to expire it. It is replaced by pirewall_adaptive; removing it
# is one checked transaction, and it is never recreated.
retire_v1_adaptive_table() {
  local tables
  if ! tables="$(nft list tables 2>/dev/null)"; then
    (( DRY_RUN )) && warn "cannot read the ruleset without root — a real run retires any v1 'inet pirewall' table"
    return 0
  fi
  grep -qx 'table inet pirewall' <<<"$tables" || return 0
  warn "found the v1 adaptive table inet pirewall; v2 enforces through pirewall_adaptive instead"
  local retire="${RENDERED}/retire-v1-adaptive.nft"
  printf '%s\n' '#!/usr/sbin/nft -f' \
    '# Written by pirewall-start: remove the v1 adaptive table, idempotently.' \
    'add table inet pirewall' 'delete table inet pirewall' > "$retire"
  run nft -c -f "$retire" || die "retiring inet pirewall failed its syntax check"
  run nft -f "$retire"
  ok "removed the v1 table inet pirewall"
}

# Bindings (lease file + [[antispoof.static]]) and the allowlist MAC+IP pairs,
# through FirewallManager, the single writer of those sets (D1, D3).
seed_kernel_sets() {
  step "Seed bindings and allow_bound"
  if (( SKIP_NFT )); then skip "--skip-nft given"; SEEDED=0; return 0; fi
  if (( DRY_RUN )); then
    run "${HELPER[@]}" seed
    SEEDED="<seed result>"
    return 0
  fi
  local out
  out="$(helper seed)" || die "seeding the binding sets could not run"
  SEEDED="${out##*SEEDED=}"
  if [[ "$SEEDED" == "1" ]]; then
    ok "bindings seeded"
  else
    warn "the binding seed failed — the raw guard stays in observe (ADDENDUM_4.md D2)"
  fi
}

# Every verdict chain set in its own atomic batch, through
# FirewallManager.set_guard_mode (D1's single permitted static write).
set_guard_verdicts() {
  step "Set the guard verdicts"
  if (( SKIP_NFT )); then skip "--skip-nft given"; return 0; fi
  local -a modes; mapfile -t modes < <(guard_args)
  run "${HELPER[@]}" guards --seeded "$SEEDED" "${modes[@]}"
  ok "guards set (defaults: input enforce, raw enforce if seeded, forward observe)"
}

install_units() {
  step "Install systemd units"
  local -a units=(pirewall-core.service pirewall-api.service pirewall-crashloop-alert.service)
  (( WANT_PORTAL )) && units+=(pirewall-portal.service)

  for unit in "${units[@]}"; do
    run install -m 0644 "${REPO_ROOT}/deploy/systemd/${unit}" "${UNIT_DIR}/${unit}"
    ok "installed ${unit}"
  done
  run systemctl daemon-reload
}

start_core_and_api() {
  step "Start pirewall-core"
  start_unit pirewall-core.service "core RPC socket" "test -S '${CORE_SOCK}'"
  if (( WANT_PORTAL )); then
    wait_for "portal RPC socket" "test -S '${PORTAL_SOCK}'" \
      || die "pirewall-core did not create ${PORTAL_SOCK} — is portal.enabled true?"
  fi

  step "Start pirewall-api"
  start_unit pirewall-api.service "control panel on :${API_PORT}" \
    "ss -ltn | grep -q ':${API_PORT} '"
}

start_portal() {
  (( WANT_PORTAL )) || return 0
  step "Start pirewall-portal"
  start_unit pirewall-portal.service "sign-in page on ${PORTAL_HOST}:${PORTAL_PORT}" \
    "curl -sf -o /dev/null 'http://${PORTAL_HOST}:${PORTAL_PORT}/portal/health'"

  if (( ! DRY_RUN )); then
    local count
    count="$("$VENV_PY" - <<PY 2>/dev/null || echo 0
from pirewall.portal.store import PortalUserStore
print(len(PortalUserStore("${USER_STORE}").list_users()))
PY
)"
    if [[ "$count" == "0" ]]; then
      warn "no portal accounts exist yet — nobody can sign in. Create one:"
      warn "  sudo -u pirewall-core uv run python -m scripts.deployment.portal_users add <name>"
    else
      ok "${count} portal account(s) in the store"
    fi
  fi
}

load_portal_gate() {
  (( WANT_PORTAL )) || return 0
  step "Load the captive-portal gate"
  if (( SKIP_NFT )); then skip "--skip-nft given"; return 0; fi

  # Deliberately last. This table rejects forwarding for unauthenticated LAN
  # clients; loading it while the sign-in page is down gates the protected
  # network with nowhere to sign in.
  local portal="${RENDERED}/portal.nft"
  [[ -f "$portal" ]] || (( DRY_RUN )) || die "missing ${portal}"

  # v1 -> v2: `authed` became `ipv4_addr . ether_addr` (ADDENDUM_4.md D3).
  # nft cannot change an existing set's type, so loading the new file over
  # a v1 table fails. Delete and reload in ONE transaction: if anything in
  # it fails, the old table is still there and the LAN is never ungated.
  case "$(portal_table_state)" in
    outdated)
      warn "inet pirewall_portal has a v1 IP-only authed set; nft cannot change a set's type"
      warn "  replacing the table in one transaction: every LAN client is signed out once"
      local migration="${RENDERED}/portal-migrate.nft"
      if (( DRY_RUN )); then
        skip "would write ${migration#"$REPO_ROOT"/}"
      else
        printf '%s\n' \
          '#!/usr/sbin/nft -f' \
          '# Written by pirewall-start: replace a v1 pirewall_portal table in one transaction.' \
          'delete table inet pirewall_portal' \
          "include \"${portal}\"" > "$migration"
      fi
      run nft -c -f "$migration" || die "the portal migration failed its syntax check — the old table is still loaded"
      run nft -f "$migration" || die "the portal migration failed — the old table is still loaded"
      ok "replaced table inet pirewall_portal (sessions are now bound to ip . mac)"
      return 0
      ;;
    unknown)
      warn "cannot read the ruleset without root — whether inet pirewall_portal needs"
      warn "  the v1 -> v2 migration is undecided. A real run checks and does it."
      ;;
  esac

  run nft -c -f "$portal" || die "portal.nft failed its syntax check — nothing was loaded"
  run nft -f "$portal"
  ok "loaded table inet pirewall_portal (LAN forwarding now requires sign-in)"
}

# absent | current | outdated | unknown. `outdated` is a pirewall_portal
# table whose `authed` set is not `ipv4_addr . ether_addr`, or has none.
portal_table_state() {
  local tables set_def
  if ! tables="$(nft list tables 2>/dev/null)"; then
    echo unknown
    return 0
  fi
  if ! grep -qx 'table inet pirewall_portal' <<<"$tables"; then
    echo absent
    return 0
  fi
  if ! set_def="$(nft list set inet pirewall_portal authed 2>/dev/null)"; then
    echo outdated
    return 0
  fi
  if grep -Eq 'type[[:space:]]+ipv4_addr[[:space:]]*\.[[:space:]]*ether_addr' <<<"$set_def"; then
    echo current
  else
    echo outdated
  fi
}

install_dnsmasq_dropin() {
  (( WANT_PORTAL )) || return 0
  step "Captive-portal discovery (DHCP option 114)"

  if ! pgrep -af dnsmasq 2>/dev/null | grep -q 'dnsmasq-shared.d'; then
    warn "NetworkManager's shared-mode dnsmasq is not running — skipping option 114"
    warn "  clients will still reach the portal via the port-80 redirect"
    return 0
  fi

  local src="${RENDERED}/dnsmasq-portal.conf"
  [[ -f "$src" ]] || die "missing ${src}"

  if [[ -f "$DNSMASQ_DROPIN" ]] && cmp -s "$src" "$DNSMASQ_DROPIN"; then
    skip "drop-in already current"
    return 0
  fi

  run install -D -m 0644 "$src" "$DNSMASQ_DROPIN"
  ok "installed ${DNSMASQ_DROPIN}"
  warn "restart the AP for clients to pick it up:"
  warn "  sudo nmcli connection down <ap-connection> && sudo nmcli connection up <ap-connection>"
}

# PLAN_v3 §6 step 7 / G7: versions, hashes, modes, the env tag and a ruleset
# hash, at /var/lib/pirewall/manifest.json plus the --manifest copy.
write_manifest() {
  step "Run manifest"
  local -a args=(manifest --out "$STATE_MANIFEST")
  [[ -n "$MANIFEST_COPY" ]] && args+=(--out "$MANIFEST_COPY")
  [[ -n "$DATA_MODE" ]] && args+=(--data-mode "$DATA_MODE")
  [[ -n "$ENGINE" ]] && args+=(--engine "$ENGINE")
  (( SKIP_NFT )) && args+=(--no-kernel)
  local -a modes; mapfile -t modes < <(guard_args)
  run "${HELPER[@]}" "${args[@]}" "${modes[@]}"
  if [[ "$DATA_MODE" == "scripted" ]]; then
    warn "scripted mode: start the benign profiles on your client devices now:"
    warn "  python lab/benign/background.py --profile mixed   (lab/ arrives in phase 18)"
  fi
}

verify() {
  step "Verify"
  if (( DRY_RUN )); then skip "nothing to verify in a dry run"; return 0; fi

  local -a units=(pirewall-core pirewall-api)
  (( WANT_PORTAL )) && units+=(pirewall-portal)
  for unit in "${units[@]}"; do
    if [[ "$(systemctl is-active "$unit")" == "active" ]]; then
      ok "${unit} active"
    else
      fail "${unit} is $(systemctl is-active "$unit")"
      return 1
    fi
  done

  nft list tables | sed 's/^/    /'

  if (( WANT_PORTAL )); then
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' "http://${PORTAL_HOST}:${PORTAL_PORT}/portal" || echo 000)"
    [[ "$code" == "200" ]] && ok "sign-in page responds 200" || warn "sign-in page returned ${code}"
  fi

  # Losing the Pi's own upstream is the loudest possible failure of a
  # ruleset change, so check it explicitly rather than assuming.
  if ping -c1 -W2 "$GATEWAY" >/dev/null 2>&1; then
    ok "upstream gateway ${GATEWAY} reachable"
  else
    warn "cannot reach upstream gateway ${GATEWAY} — check the ruleset"
  fi
}

summary() {
  local latest=""
  [[ -f "${ROLLBACK_DIR}/.latest" ]] && latest="$(cat "${ROLLBACK_DIR}/.latest")"

  printf '\n%s%s%s\n' "$C_BOLD" "pirewall is up." "$C_RESET"
  printf '  Control panel   https://%s:%s/control-panel  (from the Admin PC)\n' "$ADMIN_PC" "$API_PORT"
  printf '                  https://127.0.0.1:%s/control-panel  (on the Pi, needs admin.allow_local_console)\n' "$API_PORT"
  if (( WANT_PORTAL )); then
    printf '  Sign-in page    http://%s:%s/portal\n' "$PORTAL_HOST" "$PORTAL_PORT"
    printf '  Signed-in now   sudo nft list set inet pirewall_portal authed\n'
  fi
  printf '  Enforcement     %s (adaptive)\n' "$ENFORCEMENT"
  printf '  Guards          sudo nft list chain inet pirewall_static guard_verdict_input  (etc.)\n'
  printf '  Manifest        %s\n' "$STATE_MANIFEST"
  printf '\n%sRollback%s\n' "$C_BOLD" "$C_RESET"
  printf '  Drop every v2 table (panic)  sudo scripts/deployment/pirewall-start --panic\n'
  if (( WANT_PORTAL )); then
    printf '  Ungate the LAN immediately   sudo nft delete table inet pirewall_portal\n'
  fi
  [[ -n "$latest" ]] && \
    printf '  Restore the whole ruleset    sudo nft flush ruleset && sudo nft -f deploy/rollback/ruleset-%s.nft\n' "$latest"
  printf '  Stop everything              sudo systemctl stop pirewall-portal pirewall-api pirewall-core\n'
}

# ----------------------------------------------------------------- panic

# ADDENDUM_4.md D5. Deletes inet pirewall_adaptive, inet pirewall_static and
# arp pirewall_static_arp — nothing else. Through pirewall-core when it
# answers (so its rules go REMOVED and its mode SHADOW), directly otherwise.
# The helper logs it to the journal at CRITICAL and prints the restore line.
panic_main() {
  need_root
  step "PANIC: remove pirewall's v2 tables"
  cd "$REPO_ROOT"
  require_venv
  run "${HELPER[@]}" panic --actor "pirewall-start (uid ${EUID})"
  printf '\n%s\n' "Restore: re-run  sudo ${BASH_SOURCE[0]}"
}

# ------------------------------------------------------------- lab victim

# The forward-path victim (PLAN_v3 §0.4): a `labvictim` netns behind the veth
# `lab0`, a routed /30 from [lab], running sshd, nginx, iperf3 and a DNS
# responder. LAN -> lab0 crosses the forward hook like Internet traffic. The
# `pirewall_lab` table permits it only while the victim is up. Idempotent.
lab_main() {
  need_root
  cd "$REPO_ROOT"
  require_venv
  require_binary ip "Install it:  sudo apt install iproute2"
  require_binary nft "Install it:  sudo apt install nftables"
  [[ -f "$CONFIG_FILE" ]] || refuse "no config at ${CONFIG_FILE}"
  local lab_env
  lab_env="$(helper lab-env)" || refuse "could not read [lab] from ${CONFIG_FILE}"
  eval "$lab_env"
  if [[ "$LAB_VICTIM" == "up" ]]; then lab_up; else lab_down; fi
}

lab_netns_exists() { ip netns list 2>/dev/null | awk '{print $1}' | grep -qx "$LAB_NETNS"; }

lab_up() {
  step "Lab victim up: netns ${LAB_NETNS}, ${LAB_HOST_IF} ${LAB_HOST_IP}/${LAB_PREFIX} -> ${LAB_VICTIM_IP}"
  if lab_netns_exists; then skip "netns ${LAB_NETNS} exists"; else run ip netns add "$LAB_NETNS"; ok "created netns ${LAB_NETNS}"; fi

  if ip link show "$LAB_HOST_IF" >/dev/null 2>&1; then
    skip "veth ${LAB_HOST_IF} exists"
  else
    run ip link add "$LAB_HOST_IF" type veth peer name "$LAB_PEER_IF"
    run ip link set "$LAB_PEER_IF" netns "$LAB_NETNS"
    ok "created veth ${LAB_HOST_IF} <-> ${LAB_NETNS}:${LAB_PEER_IF}"
  fi
  if ip -4 addr show dev "$LAB_HOST_IF" 2>/dev/null | grep -q "inet ${LAB_HOST_IP}/"; then
    skip "${LAB_HOST_IF} has ${LAB_HOST_IP}"
  else
    run ip addr add "${LAB_HOST_IP}/${LAB_PREFIX}" dev "$LAB_HOST_IF"
  fi
  run ip link set "$LAB_HOST_IF" up
  if ip -n "$LAB_NETNS" -4 addr show dev "$LAB_PEER_IF" 2>/dev/null | grep -q "inet ${LAB_VICTIM_IP}/"; then
    skip "victim has ${LAB_VICTIM_IP}"
  else
    run ip -n "$LAB_NETNS" addr add "${LAB_VICTIM_IP}/${LAB_PREFIX}" dev "$LAB_PEER_IF"
  fi
  run ip -n "$LAB_NETNS" link set lo up
  run ip -n "$LAB_NETNS" link set "$LAB_PEER_IF" up
  run ip -n "$LAB_NETNS" route replace default via "$LAB_HOST_IP"
  ok "addresses and routes in place"

  run install -d -m 0750 "$LAB_RUN_DIR"
  lab_start_services

  local ruleset="${RENDERED}/pirewall_lab.nft"
  run "${HELPER[@]}" lab-ruleset --out "$ruleset"
  run nft -c -f "$ruleset" || die "pirewall_lab failed its syntax check — nothing was loaded"
  run nft -f "$ruleset"
  ok "loaded table inet ${LAB_TABLE}: ${LAN_IF} -> ${LAB_HOST_IF} ${LAB_VICTIM_IP} is forwarded while the victim is up"
}

# Start one service inside the victim netns unless its pidfile names a live
# process. A missing binary is a warning, not a failure: the victim is still
# useful for the services that are installed.
lab_service() {
  local name="$1" binary="$2"; shift 2
  local pidfile="${LAB_RUN_DIR}/${name}.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    skip "${name} already running (pid $(cat "$pidfile"))"
    return 0
  fi
  if ! command -v "$binary" >/dev/null 2>&1; then
    warn "${name}: ${binary} is not installed — the victim runs without it"
    return 0
  fi
  run ip netns exec "$LAB_NETNS" "$@"
  ok "${name} started in ${LAB_NETNS}"
}

lab_start_services() {
  local nginx_conf="${LAB_RUN_DIR}/nginx.conf"
  if (( ! DRY_RUN )); then
    cat > "$nginx_conf" <<NGINX
pid ${LAB_RUN_DIR}/nginx.pid;
error_log ${LAB_RUN_DIR}/nginx-error.log;
events {}
http {
  access_log off;
  server { listen ${LAB_VICTIM_IP}:80; location / { return 200 "pirewall lab victim\n"; } }
}
NGINX
  fi
  lab_service sshd /usr/sbin/sshd /usr/sbin/sshd -o "PidFile=${LAB_RUN_DIR}/sshd.pid" -o "ListenAddress=${LAB_VICTIM_IP}"
  lab_service nginx nginx nginx -c "$nginx_conf"
  lab_service iperf3 iperf3 iperf3 -s -D -B "$LAB_VICTIM_IP" --pidfile "${LAB_RUN_DIR}/iperf3.pid"
  lab_service dns dnsmasq dnsmasq --conf-file=/dev/null --no-resolv --no-hosts --bind-interfaces \
    "--listen-address=${LAB_VICTIM_IP}" "--address=/#/${LAB_VICTIM_IP}" "--pid-file=${LAB_RUN_DIR}/dns.pid"
}

lab_down() {
  step "Lab victim down: netns ${LAB_NETNS}"
  local name pidfile
  for name in sshd nginx iperf3 dns; do
    pidfile="${LAB_RUN_DIR}/${name}.pid"
    if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      run kill "$(cat "$pidfile")"
      ok "stopped ${name}"
    fi
    run rm -f "$pidfile"
  done

  # add + delete in one file: removes the table if present, succeeds if not.
  local retire="${RENDERED}/pirewall_lab-down.nft"
  if (( ! DRY_RUN )); then
    mkdir -p "$RENDERED"
    printf '%s\n' '#!/usr/sbin/nft -f' "add table inet ${LAB_TABLE}" "delete table inet ${LAB_TABLE}" > "$retire"
  fi
  run nft -c -f "$retire" || die "removing ${LAB_TABLE} failed its syntax check"
  run nft -f "$retire"
  ok "table inet ${LAB_TABLE} removed: LAN -> lab forwarding is closed again"

  # Deleting the netns deletes both veth ends with it.
  if lab_netns_exists; then run ip netns del "$LAB_NETNS"; ok "deleted netns ${LAB_NETNS}"; else skip "netns ${LAB_NETNS} already gone"; fi
  if ip link show "$LAB_HOST_IF" >/dev/null 2>&1; then run ip link del "$LAB_HOST_IF"; fi
}

# -------------------------------------------------------------- mock mode

# ADDENDUM_4.md D7 `mock`: no root, no nft, nothing on the host changes.
# pirewall-core replays pcaps (capture.backend = replay) against in-memory
# firewall fakes; pirewall-api serves https://127.0.0.1 from a throwaway
# certificate. Everything lives in the run directory. Env tag: mock, always.
mock_main() {
  step "Mock mode (no root, no nft)"
  (( EUID != 0 )) || refuse "--data-mode mock never needs root; run it as your own user" \
    "It writes only to its run directory, and root would leave files there you cannot remove."
  cd "$REPO_ROOT"
  require_venv
  local config_source="$CONFIG_FILE"
  [[ -f "$config_source" ]] || config_source="${REPO_ROOT}/config/default_config.toml"
  local pcap="${PCAP:-${REPO_ROOT}/lab/mock/out}"
  [[ -e "$pcap" ]] || refuse "no pcap at ${pcap}" \
    "Pass one:  --pcap PATH  (a .pcap/.pcapng file or a directory of them). lab/mock/out is written
by lab/mock/gen_pcaps.py:  uv run python lab/mock/gen_pcaps.py --seed 1"
  local run_dir="${RUN_DIR:-${REPO_ROOT}/.pirewall-mock}"
  local api_port="${PIREWALL_MOCK_API_PORT:-18443}"

  local -a mock=(mock-config --run-dir "$run_dir" --pcap "$pcap" --api-port "$api_port")
  [[ -n "$ENGINE" ]] && mock+=(--engine "$ENGINE")

  local -a pre=(preflight --data-mode mock)
  [[ -n "$ENGINE" ]] && pre+=(--engine "$ENGINE")
  local status=0
  "$VENV_PY" -m scripts.deployment.startup --config "$config_source" "${pre[@]}" || status=$?
  (( status == 0 )) || refuse "mock preflight refused to start (see above)"
  (( CHECK_ONLY )) && { printf '\n%spreflight passed — nothing was changed (--check)%s\n' "$C_GREEN" "$C_RESET"; exit "$EXIT_OK"; }

  if (( DRY_RUN )); then
    run "$VENV_PY" -m scripts.deployment.startup --config "$config_source" "${mock[@]}"
    run "$VENV_PY" -m pirewall.main --config "${run_dir}/mock_config.toml" --data-mode mock
    run "$VENV_PY" -m pirewall.api --config "${run_dir}/mock_config.toml"
    local -a dry_manifest=(manifest --out "${run_dir}/manifest.json" --data-mode mock --no-kernel)
    [[ -n "$MANIFEST_COPY" ]] && dry_manifest+=(--out "$MANIFEST_COPY")
    [[ -n "$ENGINE" ]] && dry_manifest+=(--engine "$ENGINE")
    run "$VENV_PY" -m scripts.deployment.startup --config "${run_dir}/mock_config.toml" "${dry_manifest[@]}"
    return 0
  fi

  local mock_env
  mock_env="$("$VENV_PY" -m scripts.deployment.startup --config "$config_source" "${mock[@]}")" \
    || die "could not prepare ${run_dir}"
  eval "$mock_env"
  ok "run directory ${run_dir} (config, throwaway TLS, admin password)"

  local core_pid api_pid
  "$VENV_PY" -m pirewall.main --config "$MOCK_CONFIG" --data-mode mock >"${run_dir}/core.out" 2>&1 &
  core_pid=$!
  # shellcheck disable=SC2064  # expand the pids now, not at signal time
  trap "kill ${core_pid} 2>/dev/null || true" EXIT
  wait_for "core RPC socket" "test -S '${MOCK_CORE_SOCK}'" || die "pirewall-core did not start; see ${run_dir}/core.out"
  "$VENV_PY" -m pirewall.api --config "$MOCK_CONFIG" >"${run_dir}/api.out" 2>&1 &
  api_pid=$!
  # shellcheck disable=SC2064
  trap "kill ${api_pid} ${core_pid} 2>/dev/null || true" EXIT
  wait_for "API on 127.0.0.1:${MOCK_API_PORT}" \
    "curl -skf -o /dev/null 'https://127.0.0.1:${MOCK_API_PORT}/api/v1/health'" \
    || die "pirewall-api did not start; see ${run_dir}/api.out"

  local -a manifest=(manifest --out "${run_dir}/manifest.json" --data-mode mock --no-kernel)
  [[ -n "$MANIFEST_COPY" ]] && manifest+=(--out "$MANIFEST_COPY")
  [[ -n "$ENGINE" ]] && manifest+=(--engine "$ENGINE")
  "$VENV_PY" -m scripts.deployment.startup --config "$MOCK_CONFIG" "${manifest[@]}"

  printf '\n%s%s%s\n' "$C_BOLD" "pirewall (mock) is up — env tag: mock." "$C_RESET"
  printf '  Control panel   https://127.0.0.1:%s/control-panel  (self-signed certificate)\n' "$MOCK_API_PORT"
  printf '  Login           admin / %s\n' "$(cat "$MOCK_PASSWORD_FILE")"
  printf '  Replaying       %s\n' "$pcap"
  printf '  Logs            %s/core.out, %s/api.out\n' "$run_dir" "$run_dir"
  printf '  Stop            Ctrl-C (or kill %s)\n' "$$"
  # For anything scripting a mock run: both processes are serving.
  : > "${run_dir}/up"
  # Stop both and wait for them, so Ctrl-C returns only once core has shut
  # down cleanly (its socket removed) and nothing is left running.
  # shellcheck disable=SC2064
  trap "kill ${api_pid} ${core_pid} 2>/dev/null || true; wait ${api_pid} ${core_pid} 2>/dev/null || true; exit 0" INT TERM
  wait "$core_pid"
}

# ------------------------------------------------------------------ main

main() {
  if (( PANIC )); then panic_main "$@"; exit "$EXIT_OK"; fi
  if [[ -n "$LAB_VICTIM" ]]; then lab_main; exit "$EXIT_OK"; fi
  if [[ "$DATA_MODE" == "mock" ]]; then mock_main; exit "$EXIT_OK"; fi

  need_root "$@"
  preflight

  if (( CHECK_ONLY )); then
    printf '\n%spreflight passed — nothing was changed (--check)%s\n' "$C_GREEN" "$C_RESET"
    exit "$EXIT_OK"
  fi

  snapshot_ruleset
  ensure_accounts
  ensure_directories
  render_templates
  load_base_ruleset
  load_v2_tables
  seed_kernel_sets
  set_guard_verdicts
  install_units
  start_core_and_api
  start_portal
  load_portal_gate
  install_dnsmasq_dropin
  write_manifest
  verify
  summary
}

main "$@"
