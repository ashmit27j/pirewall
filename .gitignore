# ================================
# PiReWall - Git Ignore
# ================================
# REMOVING DATASETS TOO - take these from kaggle instead - they are too large ========================!!!!!!!!!!!!!!

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# ================================
# Dataset artifacts
# ================================

# Processed datasets
datasets/processed/

# Large/raw datasets
# Keep the raw datasets locally; do not commit them.
datasets/raw/

# ================================
# ML artifacts
# ================================

# Trained models
models/
*.pkl
*.joblib
*.onnx
*.bin
*.pt
*.pth

# ML experiment outputs
ml/runs/
ml/experiments/
ml/logs/

# ================================
# Logs
# ================================

logs/
*.log

# ================================
# Python tooling
# ================================

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Build/package artifacts
build/
dist/
*.egg-info/