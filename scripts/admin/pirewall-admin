#!/usr/bin/env bash
# pirewall-admin — drive the Pi from the Admin PC.
#
# The remote counterpart to scripts/deployment/pirewall-boot. Everything here
# runs *from the Admin PC* and reaches the Pi over SSH on the management
# interface, so it keeps working when the LAN side is being reloaded.
#
# This machine is both the admin station and the lab attacker, so the two
# roles are kept visibly apart: `up`/`status`/`panel` are admin, `ssh` drops
# you on the Pi, and nothing here runs an attack tool.
set -uo pipefail

PI_HOST="${PIREWALL_PI_HOST:-raspberrypi@192.168.101.1}"
PI_ADDR="${PI_HOST#*@}"
PI_REPO="${PIREWALL_PI_REPO:-/opt/pirewall}"
PANEL_PORT="${PIREWALL_PANEL_PORT:-8443}"
PANEL_URL="https://${PI_ADDR}:${PANEL_PORT}/control-panel"

C_BOLD=""; C_RESET=""; C_RED=""; C_GREEN=""; C_YELLOW=""
if [[ -t 1 ]]; then
  C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
fi
ok()   { printf '    %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '    %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
bad()  { printf '    %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; }
step() { printf '\n%s==> %s%s\n' "$C_BOLD" "$*" "$C_RESET"; }

usage() {
  cat <<USAGE
usage: pirewall-admin <command> [args]

  up [--engine v1|v2]  arm the Pi (runs pirewall-boot there) and open the panel
  status               one screen: reachability, services, tables, uplink, clients
  panel                open ${PANEL_URL} in a browser
  ssh [command ...]    SSH to the Pi (in ${PI_REPO}); with no command, a shell
  logs [unit] [n]      journal for a pirewall unit (default: pirewall-core, 50)
  tables               the live nftables tables
  panic                drop the v2 tables (asks first)
  sync                 push this checkout to the Pi, then the Pi to GitHub

Environment: PIREWALL_PI_HOST (${PI_HOST}), PIREWALL_PI_REPO, PIREWALL_PANEL_PORT.
USAGE
}

pi() { ssh -o BatchMode=yes -o ConnectTimeout=8 "$PI_HOST" "cd ${PI_REPO} && $*"; }

require_pi() {
  if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$PI_HOST" true 2>/dev/null; then
    bad "cannot reach ${PI_HOST}"
    printf '      Check the management link is up:  ping %s\n' "$PI_ADDR"
    printf '      SSH keys not set up?              ssh-copy-id %s\n' "$PI_HOST"
    return 1
  fi
  return 0
}

open_panel() {
  printf '    %s\n' "$PANEL_URL"
  for opener in xdg-open open; do
    if command -v "$opener" >/dev/null 2>&1; then
      "$opener" "$PANEL_URL" >/dev/null 2>&1 &
      return 0
    fi
  done
  warn "no xdg-open/open here — paste the URL above into a browser"
}

cmd_status() {
  step "pirewall status via ${PI_HOST}"
  require_pi || return 1

  local services tables route clients enforcement
  services="$(pi 'systemctl is-active pirewall-core pirewall-api pirewall-portal 2>&1 | tr "\n" " "')"
  printf '    services    %s\n' "$services"

  tables="$(pi 'sudo nft list tables 2>/dev/null | sed "s/^table //" | tr "\n" ";"')"
  if [[ "$tables" == *pirewall_adaptive* ]]; then
    ok "data plane armed"
  else
    bad "kernel tables absent — core is running against an empty ruleset"
    printf '      Arm it:  pirewall-admin up        (KNOWN_ISSUES #28)\n'
  fi
  printf '    tables      %s\n' "${tables:-none}"

  route="$(pi 'ip route show default 2>/dev/null | head -1')"
  [[ -n "$route" ]] && ok "uplink: ${route}" || warn "no default route on the Pi (uplink down)"

  enforcement="$(pi 'grep -m1 "^enforcement_mode" config/local_config.toml 2>/dev/null')"
  [[ -n "$enforcement" ]] && printf '    %s\n' "$enforcement"

  clients="$(pi 'ip neigh show dev "$(grep -m1 "^lan_interface" config/local_config.toml | cut -d\" -f2)" 2>/dev/null | grep -c REACHABLE')"
  printf '    LAN clients %s reachable\n' "${clients:-0}"

  if curl -skf -o /dev/null --max-time 6 "https://${PI_ADDR}:${PANEL_PORT}/api/v1/health"; then
    ok "control panel answering on ${PANEL_URL}"
  else
    warn "control panel not answering (pirewall-api down, or TLS/cert issue)"
  fi
}

cmd_up() {
  local engine=""
  [[ "${1:-}" == "--engine" ]] && { engine="--engine ${2:-}"; shift 2; }

  step "Arming the Pi"
  require_pi || return 1
  # -t so sudo and pirewall-boot's progress render live rather than arriving
  # in one lump at the end.
  if ssh -t "$PI_HOST" "cd ${PI_REPO} && sudo ./scripts/deployment/pirewall-boot ${engine}"; then
    step "Control panel"
    open_panel
  else
    local status=$?
    bad "pirewall-boot failed on the Pi (exit ${status})"
    printf '      Logs:      pirewall-admin logs pirewall-core\n'
    printf '      Roll back: pirewall-admin panic\n'
    return "$status"
  fi
}

cmd_sync() {
  step "Pushing this checkout to the Pi"
  git -C "$(git rev-parse --show-toplevel)" push origin main || return 1
  step "Pushing the Pi to GitHub"
  # gh is authenticated on the Pi, not here, so GitHub pushes go from there.
  pi 'GIT_TERMINAL_PROMPT=0 git push origin main' || {
    bad "GitHub push failed — re-authenticate on the Pi:  gh auth login"
    return 1
  }
}

case "${1:-}" in
  up)      shift; cmd_up "$@" ;;
  status)  cmd_status ;;
  panel)   open_panel ;;
  tables)  require_pi && pi 'sudo nft list ruleset | head -120' ;;
  logs)    require_pi && pi "sudo journalctl -u ${2:-pirewall-core} -n ${3:-50} --no-pager" ;;
  ssh)     shift; if (( $# )); then pi "$@"; else ssh -t "$PI_HOST" "cd ${PI_REPO} && exec \$SHELL -l"; fi ;;
  panic)
    read -r -p "Drop the v2 tables on ${PI_HOST}? [y/N] " reply
    [[ "$reply" == [yY] ]] || { echo "Cancelled."; exit 0; }
    ssh -t "$PI_HOST" "cd ${PI_REPO} && sudo ./scripts/deployment/pirewall-start --panic"
    ;;
  ""|-h|--help) usage ;;
  *) printf 'pirewall-admin: unknown command %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
esac
